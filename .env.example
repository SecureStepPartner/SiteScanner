# SecureStep Site Scanner — environment configuration
# Copy this file to .env and fill in real values. .env is gitignored.

# ---- Backend authentication -------------------------------------------------
# Secret shared with the ChatGPT App Builder Action. Required on every request
# via the X-API-Key header.
SITESCANNER_API_KEY=replace_with_a_long_random_string

# ---- Nuclei / ProjectDiscovery ---------------------------------------------
# Optional. If set, the worker passes -dashboard to nuclei and results are
# uploaded to ProjectDiscovery Cloud (cloud.projectdiscovery.io).
# If unset, results stay local — captured via -jsonl only.
PDCP_API_KEY=

# ---- Redis ------------------------------------------------------------------
# Used by arq for the job queue and by the API for job-state reads.
REDIS_URL=redis://localhost:6379/0

# ---- Email delivery ---------------------------------------------------------
# Provider for the scan-result email. Set to "stub" during early development
# (writes the email to a file instead of sending). Real providers will be
# wired up once the client confirms which to use.
EMAIL_PROVIDER=stub
EMAIL_FROM=reports@securestep.example

# ---- Scan controls ----------------------------------------------------------
SCAN_TIMEOUT_SECONDS=900
MAX_CONCURRENT_SCANS=3

# ---- Server -----------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
