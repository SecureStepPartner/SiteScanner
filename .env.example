# SecureStep Site Scanner — environment configuration
# Copy this file to .env and fill in real values. .env is gitignored.

# ---- Nuclei / ProjectDiscovery ---------------------------------------------
# Optional. If set, the worker uploads results to ProjectDiscovery Cloud
# (cloud.projectdiscovery.io) and records the dashboard URL from nuclei output.
PDCP_API_KEY=
# Optional. Use this when uploading into a team workspace.
PDCP_TEAM_ID=
# Optional. Legacy/compatibility toggle used by some PDCP setups.
PDCP_TYPE=bearer
# Defaults to true. Leave enabled unless you intentionally want to disable
# cloud uploads while keeping the rest of the integration configured.
ENABLE_CLOUD_UPLOAD=true
# Defaults to true. Suppresses nuclei's cloud-upload warning output.
DISABLE_CLOUD_UPLOAD_WRN=true

# ---- Redis ------------------------------------------------------------------
# Used by arq for the job queue and by the API for job-state reads.
REDIS_URL=redis://localhost:6379/0

# ---- Email delivery ---------------------------------------------------------
# Provider for the scan-result email.
EMAIL_PROVIDER=resend
# Resend API key used by the worker to deliver reports.
RESEND_API_KEY=replace_with_resend_api_key
# Must be a verified sending address in Resend.
EMAIL_FROM=Reni N <reni.n@securestepadvisory.com>

# ---- Scan controls ----------------------------------------------------------
# Hard-capped at 900 seconds (15 minutes) by the application settings.
SCAN_TIMEOUT_SECONDS=900
MAX_CONCURRENT_SCANS=3

# ---- Server -----------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
# Public HTTPS base URL for ChatGPT/OpenAPI imports, for example:
# https://example.ngrok-free.dev
PUBLIC_BASE_URL=
